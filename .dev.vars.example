# Local dev secrets. Copy to `.dev.vars` (gitignored) and fill in real values,
# then restart the dev server. For the deployed Worker, set each with
# `wrangler secret put <NAME>`.

# Bearer token a machine must present when calling INTO the CRM API
# (GET/POST /api/hyperagent). Generate a long random string. This is the only
# direction the HyperAgent integration runs: the CRM never calls out to it.
CRM_API_KEY=""

# --- Auth (magic-link sign-in) ------------------------------------------------
# Signs session cookies. REQUIRED: better-auth throws on every request in a
# production build if this is unset, so set it before deploying:
#   openssl rand -base64 32 | wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=""

# Resend API key used to send sign-in links (wrangler secret put RESEND_API_KEY).
RESEND_API_KEY=""

# --- Smartlead.ai -------------------------------------------------------------
# Drives the /smartlead page: pushing contacts into a campaign as leads, uploading
# template copy as the campaign sequence, setting the sending schedule, and
# pulling numbers back onto the template variants.
#
# NOTE: Smartlead authenticates with an `api_key` QUERY PARAMETER, not a bearer
# header, so this value ends up inside request URLs. Never log a Smartlead URL —
# app/lib/smartlead.server.ts redacts the key from everything it returns or logs.
#
# Find it at app.smartlead.ai → Settings → Profile. Leave blank to disable: the
# page still renders and explains what's missing.
#   wrangler secret put SMARTLEAD_API_KEY
SMARTLEAD_API_KEY=""

# Shared secret for Smartlead's webhooks, which feed the Replies tab on
# /analytics. Smartlead does not sign deliveries, so the secret travels in the
# webhook URL you register in Smartlead:
#   https://<your-host>/api/smartlead/webhook?token=<this value>
# with the EMAIL_REPLY and LEAD_CATEGORY_UPDATED events (EMAIL_SENT optionally,
# to confirm replies sent from the CRM sooner). Generate a long random value:
#   openssl rand -hex 32 | wrangler secret put SMARTLEAD_WEBHOOK_SECRET
# Leave blank to disable: the endpoint then refuses every delivery.
SMARTLEAD_WEBHOOK_SECRET=""

# --- Origami (the prospecting agent) ------------------------------------------
# Drives the Prospect panel on the contacts page: you describe who you want in
# plain English, an Origami agent researches them and builds a table, and the
# panel stages the results for review before anything becomes a contact.
#
# Create one at origami.chat → Settings → API keys (a paid plan is required).
# Keys look like `og_live_…` and are parent-wide. Leave blank to disable: the
# panel still opens and explains what's missing, exactly as /smartlead does.
#   wrangler secret put ORIGAMI_API_KEY
ORIGAMI_API_KEY=""

# Optional. Origami keys act on the parent org by default; set this to scope
# every request to one child project instead (the x-origami-project header).
# Not a secret, so it can equally live in wrangler.toml [vars].
# ORIGAMI_PROJECT_ID=""

# Optional. The auth base URL is normally derived from the incoming request, so
# local dev, wrangler dev, and production all work with no config. Set this only
# if a proxy rewrites the host.
# BETTER_AUTH_URL=""

# --- Unipile (inbound replies) ------------------------------------------------
# Drives the "New replies" strip on the contacts page and the Unipile section of
# /settings: one key across the team's mailboxes and LinkedIn, read on a button
# press, matched to contacts, and written back as replies + touchpoints.
#
# Unipile authenticates with an `X-API-KEY` HEADER, so unlike Smartlead the
# secret never travels in a URL and a logged request URL is harmless.
#
# Create one at unipile.com -> dashboard -> Access Tokens. Leave blank to
# disable: /settings still renders and explains what's missing, exactly as
# /smartlead and the Prospect panel do.
#   wrangler secret put UNIPILE_API_KEY
UNIPILE_API_KEY=""

# The API host issued with that key, e.g. https://api8.unipile.com:13851.
# Requests to the wrong one 404 rather than failing usefully, so this is required
# alongside the key. Not a credential, so it can equally live in wrangler.toml
# [vars] — which is where the deployed Worker reads it from.
UNIPILE_DSN=""
