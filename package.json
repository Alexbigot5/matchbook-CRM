{
  "name": "matchbook-crm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "react-router typegen && tsc",
    "db:migrations:create": "wrangler d1 migrations create crm-db",
    "db:migrate:local": "wrangler d1 migrations apply crm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crm-db --remote"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "isbot": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
